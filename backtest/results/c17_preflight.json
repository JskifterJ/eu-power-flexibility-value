    "parse_guard_probe": {
      "method": "data.entsoe.parse_document is handed a three-point synthetic A65 document dated 2025-03-01, inside the evaluation window. No network request is made and nothing is cached.",
      "document_dates_utc": [
        "2025-03-01T00:00Z",
